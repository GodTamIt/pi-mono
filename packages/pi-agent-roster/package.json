{
  "name": "pi-agent-roster",
  "version": "0.0.0",
  "description": "Primary-agent profiles and subagent orchestration for Pi",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./src/public.ts"
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit --declaration false --declarationMap false",
    "unit": "vitest run",
    "test": "npm run unit",
    "declarations": "tsc -p tsconfig.declarations.json",
    "prepack": "npm run declarations",
    "pack:inspect": "node ./scripts/inspect-package.mjs",
    "smoke:installed": "node ./test/installed/smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3 <0.85.0",
    "@earendil-works/pi-ai": ">=0.84.3 <0.85.0",
    "@earendil-works/pi-tui": ">=0.84.3 <0.85.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "typebox": "1.3.7"
  }
}
